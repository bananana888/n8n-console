<?xml version="1.0" encoding="UTF-8"?>
<!-- ============================================================
     n8n 控制台 MSI 安装脚本（WiX Toolset v3）
     文件组件由 build.ps1 用 heat.exe 从 tools\stage 自动生成到 Components.wxs
     构建: candle installer.wxs Components.wxs + light → setup.msi
     安装位置: 默认 %LOCALAPPDATA%\n8n-console（perUser，免管理员），安装时可改
     ============================================================ -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="n8n 控制台" Language="2052" Version="4.0.0"
           Manufacturer="bananana888" UpgradeCode="D3A7F8B2-9C4E-4E1A-8F2B-6C5D9E1A7B3C" Codepage="65001">
    <Package InstallerVersion="200" Compressed="yes" InstallScope="perUser" Manufacturer="bananana888" />
    <MajorUpgrade DowngradeErrorMessage="已安装更高版本，无法降级。" />
    <MediaTemplate EmbedCab="yes" />

    <!-- 安装目录选择 UI（WixUIExtension） -->
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <UIRef Id="WixUI_InstallDir" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <Directory Id="INSTALLFOLDER" Name="n8n-console" />
      </Directory>
      <Directory Id="DesktopFolder" />
      <Directory Id="ProgramMenuFolder" />
    </Directory>

    <!-- 桌面快捷方式（exe 自带图标，快捷方式自动使用） -->
    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="DesktopShortcut" Guid="D3A7F8B2-9C4E-4E1A-8F2B-6C5D9E1A7B3D">
        <Shortcut Id="DesktopShortcutN8n" Directory="DesktopFolder" Name="n8n 控制台"
                  Target="[INSTALLFOLDER]n8n-console.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="DesktopShortcutRemove" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\n8n-console" Name="installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
      <!-- 开始菜单卸载程序 -->
      <Component Id="StartMenuUninstall" Guid="D3A7F8B2-9C4E-4E1A-8F2B-6C5D9E1A7B3F">
        <Shortcut Id="UninstallShortcut" Directory="ProgramMenuFolder" Name="卸载 n8n 控制台"
                  Target="[SystemFolder]msiexec.exe"
                  Arguments="/x [ProductCode]" />
        <RemoveFolder Id="StartMenuRemove" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\n8n-console" Name="uninstall" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Feature Id="Main" Title="n8n 控制台" Level="1">
      <ComponentGroupRef Id="MainComponentGroup" />
      <ComponentRef Id="DesktopShortcut" />
      <ComponentRef Id="StartMenuUninstall" />
    </Feature>
  </Product>
</Wix>
